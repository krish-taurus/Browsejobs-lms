# =============================================================================
# BrowseJobs LMS — API (.env.example)
# Placeholder values only. NEVER commit real secrets (see CLAUDE.md guardrails).
# Copy to .env and fill in per-environment. Local service hosts match /docker.
# =============================================================================

APP_NAME="BrowseJobs LMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Kolkata
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ----- Database (MySQL 8 — see /docker) --------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=browsejobs
DB_USERNAME=browsejobs
DB_PASSWORD=changeme

# ----- Session / Cache / Queue -----------------------------------------------
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis

# ----- Auth (Sanctum SPA cookie — see ADR 0004) ------------------------------
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Fallback tenant for hosts without a domain mapping (single-tenant/local dev).
# Leave blank in true multi-tenant environments so unknown hosts 404.
DEFAULT_TENANT_SLUG=browsejobs

CACHE_STORE=redis
CACHE_PREFIX=

# ----- Redis (see /docker) ---------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ----- Horizon ---------------------------------------------------------------
HORIZON_PREFIX=browsejobs_horizon

# ----- Mail (Mailpit locally — see /docker) ----------------------------------
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@browsejobs.ai"
MAIL_FROM_NAME="${APP_NAME}"

# ----- S3-compatible object storage (MinIO locally — see /docker) ------------
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=changeme
AWS_DEFAULT_REGION=ap-south-1
AWS_BUCKET=browsejobs
AWS_ENDPOINT=http://127.0.0.1:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# ----- AI Learning Engine (see app/Services/AI + config/ai.php) --------------
# Pick the active LLM vendor: anthropic | openai | kimi | deepseek | grok | custom
AI_PROVIDER=anthropic
AI_DAILY_TOKEN_BUDGET_PER_STUDENT=200000

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Kimi (Moonshot)
KIMI_API_KEY=
KIMI_MODEL=kimi-k3

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Grok (xAI)
GROK_API_KEY=
GROK_MODEL=grok-4

# Any other OpenAI-compatible endpoint (Ollama, Together, vLLM, ...)
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_MODEL=

# ----- Voice AI (mock interviewer / CRM voice agent) -------------------------
VAPI_API_KEY=
VAPI_WEBHOOK_SECRET=
RETELL_API_KEY=

# ----- Zoom (Server-to-Server OAuth) -----------------------------------------
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_WEBHOOK_SECRET_TOKEN=
# Account owner's email — the default meeting host for Server-to-Server OAuth
# (which has no "me" user). Set this so meetings can be created without a
# per-trainer Zoom license. Leave blank to fall back to "me".
ZOOM_DEFAULT_HOST_ID=

# ----- Razorpay (payments — use test keys in non-prod) -----------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ----- WhatsApp Cloud API ----------------------------------------------------
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Maps the connected WABA to a tenant slug (single-business P2.4).
WHATSAPP_TENANT_SLUG=

# ----- Meta Lead Ads webhook -------------------------------------------------
META_LEAD_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=
# Maps the connected Meta business/page to a tenant slug (single-business P2.1).
META_TENANT_SLUG=

# ----- Judge0 (coding labs code execution) -----------------------------------
JUDGE0_URL=http://127.0.0.1:2358
JUDGE0_AUTH_TOKEN=

# ----- JSearch live job feed (optional; PRD §6.22 / ADR 0045) -----------------
# Licensed API (RapidAPI) — aggregates LinkedIn/Indeed/Naukri postings legally,
# NO scraping. Blank = the feed's API source stays off. Get a key at rapidapi.com
# (search "JSearch"), then create an "api" source in Admin → Job feed.
JSEARCH_API_KEY=
JSEARCH_API_HOST=jsearch.p.rapidapi.com

# ----- Google sign-in (optional; button hides until configured) --------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# ----- Google Calendar (optional mentor availability sync) -------------------
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# ----- Magic links -----------------------------------------------------------
MAGIC_LINK_TTL_MINUTES=1440
MAGIC_LINK_AUTH_TTL_MINUTES=15

VITE_APP_NAME="${APP_NAME}"

# Candidate verification (PRD-E F9). Each check routes to a provider; `manual`
# ships and needs no credentials, so these are optional. Point a kind at a
# real issuer/BGV vendor once contracted — never commit its credentials.
VERIFY_IDENTITY_PROVIDER=manual
VERIFY_EDUCATION_PROVIDER=manual
VERIFY_EMPLOYMENT_PROVIDER=manual
VERIFY_DOCUMENTS_PROVIDER=manual

# BGV sources. BrowseJobs owns these, not the employer. Prefer entering them
# in Admin → Settings → Background verification, where they are stored
# encrypted; these env names exist only as a fallback and must stay blank in
# version control. A blank credential is not an error — the provider reports
# that it cannot run and the check falls to a human reviewer.
DIGILOCKER_BASE_URL=
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
EPFO_BASE_URL=
EPFO_API_KEY=

# Multiplier on every AI feature's token ceiling. The per-feature limits were
# tuned against Claude, which is terse; a wordier model gets cut off mid-JSON
# and the feature silently produces nothing.
#
# A reasoning model needs the most: it bills thinking tokens against the same
# ceiling and never returns them, so the visible reply can be a third of what
# was spent. `php artisan ai:doctor --raw` prints that ratio and names the
# value to use. 1 suits Claude; 3 suits a reasoning model. You pay for tokens
# generated, not for the ceiling.
AI_TOKEN_HEADROOM=1
