# =============================================================================
# BrowseJobs LMS — API (.env.example)
# Placeholder values only. NEVER commit real secrets (see CLAUDE.md guardrails).
# Copy to .env and fill in per-environment. Local service hosts match /docker.
# =============================================================================

APP_NAME="BrowseJobs LMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Kolkata
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ----- Database (MySQL 8 — see /docker) --------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=browsejobs
DB_USERNAME=browsejobs
DB_PASSWORD=changeme

# ----- Session / Cache / Queue -----------------------------------------------
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=

# ----- Redis (see /docker) ---------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ----- Horizon ---------------------------------------------------------------
HORIZON_PREFIX=browsejobs_horizon

# ----- Mail (Mailpit locally — see /docker) ----------------------------------
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@browsejobs.ai"
MAIL_FROM_NAME="${APP_NAME}"

# ----- S3-compatible object storage (MinIO locally — see /docker) ------------
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=changeme
AWS_DEFAULT_REGION=ap-south-1
AWS_BUCKET=browsejobs
AWS_ENDPOINT=http://127.0.0.1:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# ----- Anthropic (AI Learning Engine — see app/Services/AI) ------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
AI_DAILY_TOKEN_BUDGET_PER_STUDENT=200000

# ----- Voice AI (mock interviewer / CRM voice agent) -------------------------
VAPI_API_KEY=
VAPI_WEBHOOK_SECRET=
RETELL_API_KEY=

# ----- Zoom (Server-to-Server OAuth) -----------------------------------------
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_WEBHOOK_SECRET_TOKEN=

# ----- Razorpay (payments — use test keys in non-prod) -----------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ----- WhatsApp Cloud API ----------------------------------------------------
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# ----- Meta Lead Ads webhook -------------------------------------------------
META_LEAD_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=

# ----- Judge0 (coding labs code execution) -----------------------------------
JUDGE0_URL=http://127.0.0.1:2358
JUDGE0_AUTH_TOKEN=

# ----- Google Calendar (optional mentor availability sync) -------------------
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# ----- Magic links -----------------------------------------------------------
MAGIC_LINK_TTL_MINUTES=1440
MAGIC_LINK_AUTH_TTL_MINUTES=15

VITE_APP_NAME="${APP_NAME}"
