# =============================================================================
# BrowseJobs LMS — Web (.env.example)
# Placeholder values only. NEVER commit real secrets (see CLAUDE.md guardrails).
# Public vars (NEXT_PUBLIC_*) are exposed to the browser — keep secrets server-only.
# =============================================================================

# Base URL of the Laravel API (see /apps/api)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional. Leave blank on the VPS. Code falls back to NEXT_PUBLIC_API_URL,
# which setup sets to https://api.browsejobs.ai, then to that host again.
# A copied blank value must not point production at a local artisan port.
API_URL=

# Optional. Leave blank when Next and Laravel share the VPS. Loopback is trusted.
ENQUIRY_PROXY_SECRET=

# Canonical site URL (used for SEO metadata, OG tags, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Default tenant slug for local dev (multi-tenant resolution by domain in prod)
NEXT_PUBLIC_DEFAULT_TENANT=browsejobs

# Server-only secret for API-to-web calls / revalidation webhooks
REVALIDATE_SECRET=changeme
